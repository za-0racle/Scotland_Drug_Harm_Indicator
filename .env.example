# Backend only; publishable/anon access, never service-role keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Set on the backend host to the exact frontend origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Frontend only. Local Vite uses its /api proxy; production must use the deployed API URL.
VITE_API_BASE_URL=/api/v1
